// Tang Nano 20K v3923: CLK0 audio, fixed 27 MHz reference, S2 reset.
IO_LOC "clk_audio" 10;
IO_PORT "clk_audio" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "reset_button" 87;
IO_PORT "reset_button" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// Existing onboard MAX98357A path.
IO_LOC "PA_EN" 51;
IO_LOC "HP_DIN" 54;
IO_LOC "HP_WS" 55;
IO_LOC "HP_BCK" 56;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 DRIVE=4;
