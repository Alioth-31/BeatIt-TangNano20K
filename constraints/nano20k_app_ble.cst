// Tang Nano 20K revision 3923, verified against official 2025-08-28 schematic.
// Selected pins are also identical on 3921.
IO_LOC "clk_audio" 10;
// I2C peripheral bus: open drain, external 3.3V pull-ups required.
IO_LOC "peripheral_sda" 85;
IO_LOC "peripheral_scl" 80;
IO_PORT "peripheral_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "peripheral_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "clk_audio" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "reset_button" 87;
IO_LOC "test_button" 88;
IO_PORT "reset_button" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "test_button" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
